{
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/pyodide/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/verify.py": {
      "includeFiles": "engine/gapfinder.py"
    }
  }
}
