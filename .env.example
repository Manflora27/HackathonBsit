# Client (safe to ship): Supabase Project URL + publishable key (Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only (Vercel project env). Never put these in the client, the APK, or git.
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODELS=openrouter/auto
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=alloy
# SUPABASE_SERVICE_ROLE_KEY is used only by api/publish.ts (below).

# Lesson cache: server-side publishing (api/publish.ts) and key re-check (api/verify.py).
LESSON_SIGNING_KEY=          # any long random string; signs generated lessons and authorises /api/verify
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server only, never in the client
