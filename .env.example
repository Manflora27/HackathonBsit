# Client (safe to ship): Supabase Project URL + publishable key (Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only (Vercel project env). Never put these in the client, the APK, or git.
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODELS=openrouter/auto
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=alloy
# SUPABASE_SECRET_KEY is NOT used by the app. Don't add it unless you write a server function that needs it.
