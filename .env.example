# Browser (public)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_LOCAL_ACCOUNTS=1   # dev only: on-device test accounts instead of real Supabase sign-in (the e2e tests use this)

# Server only (api/*, also served locally by `npm run dev`)
OPENROUTER_API_KEY=
LESSON_SIGNING_KEY=          # any long random string; signs generated lessons
SUPABASE_URL=                # optional: shared lesson cache
SUPABASE_SERVICE_ROLE_KEY=   # optional: shared lesson cache

# Model routing (defaults shown). Costs are OpenRouter list, Oct 2026 — verify live at
# openrouter.ai/models; providers are pinned so check the pinned provider's price.
# Text-only calls (lessons, placement, classification, tips, reviews):
# ~$0.15 / $0.60 per 1M input / output tokens. Small calls (classify, tips)
# run ~$0.0002; placement ~$0.001; a lesson ~$0.01 but is cached and shared.
# OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_TEXT_PROVIDERS=makora,together
# OPENROUTER_TEXT_EFFORT=           # default medium; none starts text in ~1s; minimal | low | high
# Reading photos of work: ~$0.075 / $0.25 per 1M in / out, roughly $0.001 per photo.
# OPENROUTER_VISION_MODEL=z-ai/glm-5.3-flash
# OPENROUTER_VISION_PROVIDERS=together,baseten
# OPENROUTER_VISION_EFFORT=low
