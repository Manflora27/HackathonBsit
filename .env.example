# Server-side only (Vercel project env). Never put these in the client or the APK.
OPENROUTER_API_KEY=
# Comma-separated; OpenRouter falls back down the list. Pick by testing on the golden set.
OPENROUTER_FAST_MODELS=openrouter/auto
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=alloy
