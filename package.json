{
  "name": "gap-finder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predev": "node scripts/fetch-pyodide.mjs",
    "prebuild": "node scripts/fetch-pyodide.mjs",
    "test:engine": "cd engine && uv run --no-project --with pytest --with sympy pytest -q",
    "test:e2e": "playwright test",
    "cap:sync": "npm run build && npx cap sync",
    "audit:lessons": "tsx --env-file=.env.local scripts/audit-lessons.ts",
    "build:prereqs": "tsx --env-file=.env.local scripts/build-prereqs.ts"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "katex": "^0.18.10",
    "motion": "^13.4.6",
    "partial-json": "^0.1.7",
    "pyodide": "^314.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
